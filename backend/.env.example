# Postgres with pgvector. Matches docker-compose.yml; change user/password for a local install.
DATABASE_URL=postgresql+asyncpg://raglab:raglab@localhost:5432/raglab

# Embeddings: "local" (fastembed, no key) or "openai" (needs OPENAI_API_KEY).
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Answer models. CLIs on PATH are used with your own login; keys enable the APIs.
# CLAUDE_CLI=claude
# CODEX_CLI=codex
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Run the ingestion worker inside the API process (set false to run `uv run raglab-worker`).
EMBEDDED_WORKER=true
